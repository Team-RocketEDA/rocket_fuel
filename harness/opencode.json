{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "meta": {
      "name": "Meta Model API",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.meta.ai/v1",
        "apiKey": "{env:MODEL_API_KEY}"
      },
      "models": {
        "muse-spark-1.3": {
          "name": "Muse Spark 1.3",
          "attachment": true,
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "limit": { "context": 1048576, "output": 32768 }
        },
        "muse-spark-1.3-contributor": {
          "name": "Muse Spark 1.3 Contributor (cheap; Meta may train on prompts, dev/demo data only)",
          "attachment": true,
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "limit": { "context": 1048576, "output": 32768 }
        },
        "muse-wonder-1.0": {
          "name": "Muse Wonder 1.0 (the second-opinion reviewer)",
          "attachment": true,
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "limit": { "context": 1048576, "output": 32768 }
        }
      }
    }
  },

  "model": "meta/muse-spark-1.3",
  "small_model": "meta/muse-spark-1.3",
  "enabled_providers": ["meta"],
  "default_agent": "rocket-approval",

  "mcp": {
    "rocket": {
      "type": "local",
      "command": ["uv", "run", "--quiet", "--project", "{env:ROCKET_FUEL_HOME}/mcp-stub", "rocket-stub"],
      "environment": { "ROCKET_STUB_ITERATION_LIMIT": "3" },
      "enabled": true
    }
  },

  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "edit": {
      "*": "deny",
      "design/**": "ask",
      "tests/**": "ask",
      "workflows/**": "ask",
      "ip/**": "ask",
      "src/**": "ask",
      "rtl/**": "ask",
      "docs/**": "ask",
      "scripts/**": "ask",
      "README.md": "ask",
      "ip/manifest.yaml": "deny",
      "constraints.yaml": "ask",
      "results/**": "deny",
      "exports/**": "deny",
      ".rocket/**": "deny",
      ".opencode/**": "deny",
      ".git/**": "deny"
    },
    "bash": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "task": "deny",
    "external_directory": "deny",
    "skill": "deny",
    "doom_loop": "ask",
    "rocket_*": "allow"
  },

  "agent": {
    "rocket-approval": {
      "description": "RocketEDA chip-design agent. Asks before design edits, IP registration, long jobs and export.",
      "mode": "primary",
      "model": "meta/muse-spark-1.3",
      "prompt": "{file:./prompts/rocket-agent.md}",
      "temperature": 0.2,
      "steps": 80,
      "permission": {
        "rocket_apply_revision": "ask",
        "rocket_ip_register": "ask",
        "rocket_ip_instantiate": "ask",
        "rocket_generate_views": "ask",
        "rocket_export_project": "ask",
        "rocket_propose_constraint_change": "ask"
      }
    },
    "rocket-auto": {
      "description": "RocketEDA chip-design agent. Builds until done without asking. Changing targets that are already set, and export, still ask.",
      "mode": "primary",
      "model": "meta/muse-spark-1.3",
      "prompt": "{file:./prompts/rocket-agent.md}",
      "temperature": 0.2,
      "steps": 80,
      "permission": {
        "edit": {
          "*": "deny",
          "design/**": "allow",
          "tests/**": "allow",
          "workflows/**": "allow",
          "ip/**": "allow",
          "src/**": "allow",
          "rtl/**": "allow",
          "docs/**": "allow",
          "scripts/**": "allow",
          "README.md": "allow",
          "ip/manifest.yaml": "deny",
          "constraints.yaml": "allow",
          "results/**": "deny",
          "exports/**": "deny",
          ".rocket/**": "deny",
          ".opencode/**": "deny",
          ".git/**": "deny"
        },
        "doom_loop": "deny",
        "engine_generate_views": "allow",
        "rocket_export_project": "ask",
        "rocket_propose_constraint_change": "ask"
      }
    },
    "rocket-tutor": {
      "description": "Learn mode, on Muse Spark. Teaches the student from their own design and the engine's measurements. Can run checks; never edits.",
      "mode": "primary",
      "model": "meta/muse-spark-1.3",
      "prompt": "{file:./prompts/rocket-tutor.md}",
      "temperature": 0.3,
      "steps": 40,
      "permission": {
        "edit": { "*": "deny" },
        "rocket_propose_revision": "deny",
        "rocket_apply_revision": "deny",
        "rocket_ip_register": "deny",
        "rocket_ip_instantiate": "deny",
        "rocket_generate_views": "deny",
        "rocket_export_project": "deny",
        "rocket_propose_constraint_change": "deny",
        "engine_generate_views": "deny"
      }
    },
    "rocket-reviewer": {
      "description": "Second opinion, on Muse Wonder. Audits the design and the evidence independently. Reads only: no edits and no new runs.",
      "mode": "primary",
      "model": "meta/muse-wonder-1.0",
      "prompt": "{file:./prompts/rocket-reviewer.md}",
      "options": { "reasoningEffort": "high" },
      "temperature": 0.2,
      "steps": 40,
      "permission": {
        "edit": { "*": "deny" },
        "rocket_propose_revision": "deny",
        "rocket_apply_revision": "deny",
        "rocket_ip_register": "deny",
        "rocket_ip_instantiate": "deny",
        "rocket_generate_views": "deny",
        "rocket_export_project": "deny",
        "rocket_propose_constraint_change": "deny",
        "engine_generate_views": "deny",
        "rocket_run_job": "deny",
        "engine_run_*": "deny",
        "engine_cancel_job": "deny"
      }
    },
    "build": { "disable": true },
    "plan": { "disable": true }
  }
}
