{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "meta": {
      "name": "Meta Model API",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.meta.ai/v1",
        "apiKey": "{env:MODEL_API_KEY}"
      },
      "models": {
        "muse-spark-1.3": {
          "name": "Muse Spark 1.3",
          "limit": { "context": 1048576, "output": 32768 }
        },
        "muse-spark-1.3-contributor": {
          "name": "Muse Spark 1.3 Contributor (cheap; Meta may train on prompts, dev/demo data only)",
          "limit": { "context": 1048576, "output": 32768 }
        },
        "muse-wonder-1.0": {
          "name": "Muse Wonder 1.0 (comparison runs only)",
          "limit": { "context": 1048576, "output": 32768 }
        }
      }
    }
  },

  "model": "meta/muse-spark-1.3",
  "small_model": "meta/muse-spark-1.3",
  "enabled_providers": ["meta"],
  "default_agent": "rocket-approval",

  "mcp": {
    "rocket": {
      "type": "local",
      "command": ["uv", "run", "--quiet", "--project", "{env:ROCKET_FUEL_HOME}/mcp-stub", "rocket-stub"],
      "environment": { "ROCKET_STUB_ITERATION_LIMIT": "3" },
      "enabled": true
    }
  },

  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "edit": {
      "*": "deny",
      "design/**": "ask",
      "tests/**": "ask",
      "workflows/**": "ask",
      "ip/**": "ask",
      "ip/manifest.yaml": "deny",
      "constraints.yaml": "ask",
      "results/**": "deny",
      "exports/**": "deny",
      ".rocket/**": "deny",
      ".opencode/**": "deny",
      ".git/**": "deny"
    },
    "bash": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "task": "deny",
    "external_directory": "deny",
    "doom_loop": "ask",
    "rocket_*": "allow"
  },

  "agent": {
    "rocket-approval": {
      "description": "RocketEDA chip-design agent. Asks before design edits, IP registration, long jobs and export.",
      "mode": "primary",
      "prompt": "{file:./prompts/rocket-agent.md}",
      "temperature": 0.2,
      "steps": 80,
      "permission": {
        "rocket_apply_revision": "ask",
        "rocket_ip_register": "ask",
        "rocket_ip_instantiate": "ask",
        "rocket_generate_views": "ask",
        "rocket_export_project": "ask",
        "rocket_propose_constraint_change": "ask"
      }
    },
    "rocket-auto": {
      "description": "RocketEDA chip-design agent. Edits design folders and runs jobs without asking; constraints and export still ask.",
      "mode": "primary",
      "prompt": "{file:./prompts/rocket-agent.md}",
      "temperature": 0.2,
      "steps": 80,
      "permission": {
        "edit": {
          "*": "deny",
          "design/**": "allow",
          "tests/**": "allow",
          "workflows/**": "allow",
          "ip/**": "allow",
          "ip/manifest.yaml": "deny",
          "constraints.yaml": "ask",
          "results/**": "deny",
          "exports/**": "deny",
          ".rocket/**": "deny",
          ".opencode/**": "deny",
          ".git/**": "deny"
        },
        "rocket_export_project": "ask",
        "rocket_propose_constraint_change": "ask"
      }
    },
    "build": { "disable": true },
    "plan": { "disable": true }
  }
}
