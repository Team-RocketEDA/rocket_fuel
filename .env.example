# Copy to .env for local runs. Never commit real keys.

# provider/model for the design agent. The Meta default still works unchanged. Any provider the pinned
# OpenCode 1.19.5 runtime supports can be used, e.g. openai/gpt-5.1 or anthropic/claude-sonnet-4-5.
# A configuration saved in the app wins over this file; an exported value wins over both.
ROCKET_MODEL=meta/muse-spark-1.3

# Optional per-role overrides; empty inherits ROCKET_MODEL (the reviewer keeps Muse Wonder on the Meta default).
# ROCKET_SMALL_MODEL=
# ROCKET_TUTOR_MODEL=
# ROCKET_REVIEWER_MODEL=

# Custom OpenAI-compatible endpoint only:
# ROCKET_PROVIDER_TYPE=openai-compatible
# ROCKET_BASE_URL=https://your-api.example.com/v1

# Key for the selected provider. The app stores it privately; MODEL_API_KEY is Meta's name (and is accepted
# for a custom endpoint), while native providers may use OPENAI_API_KEY, ANTHROPIC_API_KEY, etc.
# Check the setup with: python3 -I scripts/doctor.py
MODEL_API_KEY=
ROCKET_PDK_ROOTS=
