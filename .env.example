# Copy to .env for local runs. Never commit real keys.

# Model for local runs. Free and keyless: beam-free passed the real repair loop fastest (fallback: opencode/nemotron-3.5-lightning-free).
# Switch to meta/muse-spark-1.3 once there is a Meta key.
ROCKET_MODEL=opencode/beam-free

# Key for Muse (meta/*). Other providers read their usual variable; set the one for your ROCKET_MODEL:
#   OPENROUTER_API_KEY   openrouter/...  (free sign-up; ":free" models, e.g. openrouter/google/gemma-4-31b-it:free)
#   GROQ_API_KEY         groq/...
#   GOOGLE_GENERATIVE_AI_API_KEY  google/...
#   ANTHROPIC_API_KEY    anthropic/...
#   OPENAI_API_KEY       openai/...
# The opencode/*-free models need no key but share one quota per machine.
# Check the setup with: python3 -I scripts/doctor.py
MODEL_API_KEY=
ROCKET_PDK_ROOTS=
