# Copy to .env for local runs. Never commit real keys.

# The agent runs on Meta models only, through the Meta Model API (https://api.meta.ai/v1).
# meta/muse-spark-1.3 is the default; meta/muse-spark-1.3-contributor is cheaper for rehearsals on demo data
# (Meta may train on its prompts and outputs).
ROCKET_MODEL=meta/muse-spark-1.3

# Your Meta Model API key (https://dev.meta.ai). Check the setup with: python3 -I scripts/doctor.py
MODEL_API_KEY=
ROCKET_PDK_ROOTS=
