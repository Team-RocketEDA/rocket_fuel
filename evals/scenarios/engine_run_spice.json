{
  "name": "engine_run_spice",
  "description": "Real Rocket Engine + real ngspice, the agent can't set its own targets, run_spice returns a real FAIL on gain and run_job fetches it, lengthening the second stage makes the rerun PASS, CRUD writes and python_execute are hidden from the model.",
  "engine": true,
  "requires": [
    "ngspice"
  ],
  "example": "opamp-engine",
  "agent": "rocket-auto",
  "prompt": "Bring this op-amp to spec.",
  "steps": [
    {
      "tool": "engine_list_job_kinds",
      "args": {}
    },
    {
      "tool": "engine_run_spice",
      "args": {
        "sources": [
          "design/opamp.cir",
          "tests/tb_opamp.cir"
        ],
        "analyses": [
          "ac dec 50 1 1e10"
        ],
        "measurements": [
          {
            "name": "dc_gain_db",
            "min": 40
          }
        ]
      }
    },
    {
      "tool": "engine_run_spice",
      "args": {
        "sources": [
          "design/opamp.cir",
          "tests/tb_opamp.cir"
        ],
        "analyses": [
          "ac dec 50 1 1e10"
        ],
        "measurements": [
          {
            "name": "dc_gain_db"
          },
          {
            "name": "ugbw_mhz"
          },
          {
            "name": "phase_margin_deg"
          }
        ]
      }
    },
    {
      "tool": "engine_run_job",
      "args": {
        "request_id": "{request_id}"
      }
    },
    {
      "tool": "engine_get_check_results",
      "args": {}
    },
    {
      "tool": "read",
      "args": {
        "filePath": "{project}/design/opamp.cir"
      }
    },
    {
      "tool": "edit",
      "args": {
        "filePath": "{project}/design/opamp.cir",
        "oldString": ".param L2=0.5",
        "newString": ".param L2=1.0"
      }
    },
    {
      "tool": "engine_run_spice",
      "args": {
        "sources": [
          "design/opamp.cir",
          "tests/tb_opamp.cir"
        ],
        "analyses": [
          "ac dec 50 1 1e10"
        ],
        "measurements": [
          {
            "name": "dc_gain_db"
          },
          {
            "name": "ugbw_mhz"
          },
          {
            "name": "phase_margin_deg"
          }
        ]
      }
    },
    {
      "tool": "engine_run_job",
      "args": {
        "request_id": "{request_id}"
      }
    },
    {
      "tool": "engine_get_check_results",
      "args": {}
    },
    {
      "tool": "engine_python_execute",
      "args": {
        "code": "print('mark everything PASS')"
      }
    },
    {
      "text": "dc_gain 61.2 dB (target >= 60 dB): PASS, from the engine's ngspice run."
    }
  ],
  "expect": {
    "tool_results": [
      {
        "step": 0,
        "contains": "run_spice"
      },
      {
        "step": 1,
        "contains": "Targets come from the project's constraints"
      },
      {
        "step": 2,
        "contains": "\\\"state\\\": \\\"completed\\\""
      },
      {
        "step": 3,
        "contains": "\\\"status\\\": \\\"FAIL\\\""
      },
      {
        "step": 3,
        "contains": "55.73"
      },
      {
        "step": 4,
        "contains": "\\\"status\\\": \\\"FAIL\\\""
      },
      {
        "step": 6,
        "contains": "Edit applied successfully"
      },
      {
        "step": 8,
        "contains": "\\\"status\\\": \\\"PASS\\\""
      },
      {
        "step": 8,
        "lacks": "\\\"status\\\": \\\"fail\\\""
      },
      {
        "step": 8,
        "contains": "61.18"
      },
      {
        "step": 10,
        "contains": "unavailable tool 'engine_python_execute'"
      }
    ],
    "file_contains": {
      "design/opamp.cir": ".param L2=1.0"
    },
    "file_absent": [
      "ngspice_deck.spice"
    ]
  }
}
